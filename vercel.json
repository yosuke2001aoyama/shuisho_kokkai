{
  "headers": [
    { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index-v2.mjs" },
    { "source": "/", "destination": "/public/index-v2.html" }
  ]
}